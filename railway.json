{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "startCommand": "php artisan optimize && php artisan serve --host=0.0.0.0 --port=$PORT",
    "numReplicas": 1,
    "restartPolicyType": "always",
    "healthchecks": [
      {
        "path": "/",
        "initialDelaySeconds": 30,
        "periodSeconds": 10
      }
    ]
  }
}